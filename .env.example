# ---------------------------------------------------------------------------
# StreamVault environment variables
# Copy to .env for local development:  cp .env.example .env
# ---------------------------------------------------------------------------

# Canonical origin used for canonicals, Open Graph URLs, robots.txt, and both
# sitemaps. Set this in your host's build environment (Cloudflare Pages /
# Vercel / GitHub Actions -> repository variable PUBLIC_SITE_URL).
# REQUIRED for production builds.
PUBLIC_SITE_URL=https://streamvault.pages.dev

# Optional: expose the site locally on a non-default port
# DEV_PORT=4321
