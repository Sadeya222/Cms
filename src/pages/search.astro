---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllVideos } from '../utils/queries';

// Interior search page — kept OUT of the index to avoid soft-duplicate penalties
// (spec §7.2: <meta name="robots" content="noindex,follow">).
const videoCount = (await getAllVideos()).length;
---

<BaseLayout
  title="Search"
  description="Search the full video library instantly."
  noindex={true}
>
  <div class="container search-wrap">
    <header class="page-head search-hero">
      <h1>Search the library</h1>
      <p>Find videos by title, description, tags, or category — instantly, in your browser.</p>
    </header>

    <div id="search" data-pagefind-ignore="all"></div>

    <p class="search-hint">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 16v-4"></path>
        <path d="M12 8h.01"></path>
      </svg>
      {videoCount} videos indexed locally — no data leaves your browser.
    </p>

    <noscript>
      <p class="empty">Search requires JavaScript. Please browse by <a href="/">category</a> instead.</p>
    </noscript>
  </div>

  <!-- Pagefind UI: loads its own WebAssembly search index built at compile time.
       Assets live at /pagefind/ after `pagefind --site dist` runs post-build. -->
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') return;
      const ui = new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: true,
        pageSize: 12,
        resetStyles: false,
        translations: {
          placeholder: 'Search videos…',
          zero_results: 'No videos match "[SEARCH_TERM]"',
        },
      });

      // Deep-link support: /search?q=term auto-runs the query.
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q) {
        ui.triggerSearch(q);
        const input = document.querySelector('#search input');
        if (input) input.value = q;
      }
    });
  </script>
</BaseLayout>
